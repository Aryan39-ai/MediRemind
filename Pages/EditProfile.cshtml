@page
@model MediRemind.Pages.EditProfileModel
@{ ViewData["Title"] = "Edit Profile"; }

@if (HttpContext.Session.GetString("UserId") == null)
{
    <div class="min-h-screen flex items-center justify-center px-4">
        <p class="text-slate-500">Please <a href="/Login" class="text-primary font-bold">log in</a> first.</p>
    </div>
}
else
{
<section class="max-w-xl mx-auto px-4 py-12">
    <a href="/Dashboard" class="text-slate-500 hover:text-primary text-sm">← Back to dashboard</a>
    <h1 class="text-3xl font-extrabold text-ink mt-3 mb-1">Edit Profile</h1>
    <p class="text-slate-500 text-sm mb-8">Update your name, email, or password.</p>

    @if (Model.SuccessMessage != null)
    {
        <div class="bg-green-50 border border-green-300 text-green-700 rounded-xl px-4 py-3 mb-6 text-sm font-semibold">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="bg-red-50 border border-red-300 text-red-700 rounded-xl px-4 py-3 mb-6 text-sm">@Model.ErrorMessage</div>
    }

    <form method="post" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-5" novalidate>
        @Html.AntiForgeryToken()

        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Full Name</label>
            <input asp-for="Input.Name" class="inp" />
            <span asp-validation-for="Input.Name" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
            <input asp-for="Input.Email" type="email" class="inp" />
            <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
        </div>

        <div class="border-t border-slate-100 pt-5">
            <p class="text-sm font-semibold text-slate-700 mb-4">Change Password <span class="text-slate-400 font-normal">(leave blank to keep current)</span></p>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Current Password</label>
                    <input asp-for="Input.CurrentPassword" type="password" class="inp" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">New Password</label>
                    <input asp-for="Input.NewPassword" type="password" placeholder="Min. 8 characters" class="inp" />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1">Confirm New Password</label>
                    <input asp-for="Input.ConfirmNewPassword" type="password" class="inp" />
                </div>
            </div>
        </div>

        <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl hover:bg-primary-dark transition">Save Changes</button>
    </form>
</section>
}
