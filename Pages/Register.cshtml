@page
@model MediRemind.Pages.RegisterModel
@{ ViewData["Title"] = "Register"; }

<section class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="bg-white rounded-2xl shadow-md border border-slate-100 w-full max-w-md p-8">

        <!-- Brand -->
        <div class="flex items-center gap-2 justify-center mb-7">
            <div class="w-9 h-9 bg-primary rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12h6m-3-3v6m-9 1V7a4 4 0 014-4h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4z"/>
                </svg>
            </div>
            <span class="text-xl font-extrabold tracking-tight"><span class="text-primary">Medi</span><span class="text-ink">Remind</span></span>
        </div>

        <h1 class="text-2xl font-extrabold text-ink mb-1">Create your account</h1>
        <p class="text-slate-500 text-sm mb-6">Free to use. No credit card required.</p>

        @if (Model.ErrorMessage != null)
        {
            <div class="bg-red-50 border border-red-300 text-red-700 rounded-xl px-4 py-3 mb-5 text-sm">@Model.ErrorMessage</div>
        }

        <form method="post" novalidate class="space-y-4">
            @Html.AntiForgeryToken()
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Full Name</label>
                <input asp-for="Input.Name" class="inp" />
                <span asp-validation-for="Input.Name" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
                <input asp-for="Input.Email" type="email" class="inp" />
                <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Password</label>
                <input asp-for="Input.Password" type="password" placeholder="Min. 8 characters" class="inp" />
                <span asp-validation-for="Input.Password" class="text-red-500 text-xs"></span>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-1">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="inp" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-500 text-xs"></span>
            </div>
            <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl hover:bg-primary-dark transition mt-2">Create Account</button>
        </form>
        <p class="text-center text-sm text-slate-500 mt-5">Already have an account? <a href="/Login" class="text-primary font-semibold hover:underline">Log in</a></p>
    </div>
</section>
