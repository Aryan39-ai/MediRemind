@page
@model MediRemind.Pages.CaregiversModel
@{ ViewData["Title"] = "Caregivers"; }

@if (!Model.IsLoggedIn)
{
    <div class="min-h-screen flex items-center justify-center px-4">
        <p class="text-slate-500">Please <a href="/Login" class="text-primary font-bold">log in</a> first.</p>
    </div>
}
else
{
<section class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-extrabold text-ink">Caregivers</h1>
    <p class="text-slate-500 text-sm mb-8">Share your medication schedule with a trusted family member or carer.</p>

    @if (Model.SuccessMessage != null)
    {
        <div class="bg-green-50 border border-green-300 text-green-700 rounded-xl px-4 py-3 mb-6 text-sm font-semibold">@Model.SuccessMessage</div>
    }
    @if (Model.ErrorMessage != null)
    {
        <div class="bg-red-50 border border-red-300 text-red-700 rounded-xl px-4 py-3 mb-6 text-sm">@Model.ErrorMessage</div>
    }

    <!-- Add caregiver form -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-6">
        <h2 class="font-bold text-ink mb-4">Add a caregiver</h2>
        <form method="post" class="flex flex-col sm:flex-row gap-3">
            @Html.AntiForgeryToken()
            <input asp-for="Input.Email" type="email" placeholder="caregiver@example.com" class="inp flex-1" />
            <button type="submit" class="bg-primary text-white font-bold px-6 py-3 rounded-xl hover:bg-primary-dark transition text-sm whitespace-nowrap">Share Access</button>
        </form>
        <p class="text-xs text-slate-400 mt-3">They will be able to view your schedule (read-only). You can revoke access at any time.</p>
    </div>

    <!-- List of caregivers -->
    @if (Model.Caregivers.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-100">
                <h2 class="font-bold text-ink">People with access</h2>
            </div>
            <div class="divide-y divide-slate-100">
                @foreach (var c in Model.Caregivers)
                {
                    <div class="px-6 py-4 flex items-center justify-between">
                        <div>
                            <p class="font-semibold text-ink">@c.CaregiverEmail</p>
                            <p class="text-xs text-slate-500">Added @c.AddedAt.ToString("dd MMM yyyy")</p>
                        </div>
                        <form method="post" asp-page-handler="Remove" onsubmit="return confirm('Remove this caregiver?');" class="inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@c.Id" />
                            <button type="submit" class="text-slate-400 hover:text-red-500 text-sm">Remove</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="bg-soft border border-sky-100 rounded-2xl p-8 text-center text-slate-500">
            <div class="w-12 h-12 bg-sky-100 rounded-xl flex items-center justify-center mx-auto mb-3">
                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <p>You have not shared access with anyone yet.</p>
        </div>
    }
</section>
}
