@page
@model MediRemind.Pages.ContactModel
@{ ViewData["Title"] = "Contact"; }

<section class="max-w-xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-extrabold text-ink mb-2">Contact Us</h1>
    <p class="text-slate-500 mb-8">Questions, feedback or feature suggestions? Send us a message.</p>

    @if (Model.SuccessMessage != null)
    {
        <div class="bg-green-50 border border-green-300 text-green-700 rounded-xl px-4 py-3 mb-6 text-sm font-semibold">@Model.SuccessMessage</div>
    }

    <form method="post" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-5" novalidate>
        @Html.AntiForgeryToken()
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Name</label>
            <input asp-for="Input.Name" class="inp" />
            <span asp-validation-for="Input.Name" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Email</label>
            <input asp-for="Input.Email" type="email" class="inp" />
            <span asp-validation-for="Input.Email" class="text-red-500 text-xs"></span>
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 mb-1">Message</label>
            <textarea asp-for="Input.Message" rows="5" class="inp resize-none"></textarea>
            <span asp-validation-for="Input.Message" class="text-red-500 text-xs"></span>
        </div>
        <button type="submit" class="w-full bg-primary text-white font-bold py-3.5 rounded-xl hover:bg-primary-dark transition">Send Message</button>
    </form>
</section>
