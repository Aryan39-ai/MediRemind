@page
@model MediRemind.Pages.HistoryModel
@{ ViewData["Title"] = "History"; }

@if (!Model.IsLoggedIn)
{
    <div class="min-h-screen flex items-center justify-center px-4">
        <p class="text-slate-500">Please <a href="/Login" class="text-primary font-bold">log in</a> first.</p>
    </div>
}
else
{
<section class="max-w-4xl mx-auto px-4 py-12">

    <!-- Header -->
    <div class="flex items-center justify-between mb-1">
        <h1 class="text-3xl font-extrabold text-ink">Dose History</h1>
        <button onclick="window.print()" class="hidden sm:flex items-center gap-2 text-sm font-semibold text-slate-500 border border-slate-200 px-4 py-2 rounded-xl hover:border-primary hover:text-primary transition print:hidden">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            Print
        </button>
    </div>
    <p class="text-slate-500 text-sm mb-8">Your dose log for the last 30 days.</p>

    <!-- Adherence summary -->
    <div class="bg-gradient-to-br from-primary to-primary-dark text-white rounded-2xl p-6 mb-8">
        <p class="text-xs uppercase tracking-widest text-sky-100 mb-1">30-Day Adherence</p>
        <p class="text-5xl font-extrabold">@Model.OverallAdherence<span class="text-2xl">%</span></p>
        <p class="text-sky-100 text-sm mt-2">@Model.TotalTaken of @Model.TotalScheduled doses taken</p>
    </div>

    <!-- Chart -->
    @if (Model.ChartLabels != "[]")
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 mb-8">
            <h2 class="font-bold text-ink mb-4 text-sm">Daily Adherence — Last 30 Days</h2>
            <div style="height:220px">
                <canvas id="adherenceChart"></canvas>
            </div>
        </div>
    }

    <!-- Filter form -->
    <form method="get" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5 mb-6 print:hidden">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-3">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wide">Medication</label>
                <select name="MedId" class="inp text-sm">
                    <option value="">All</option>
                    @foreach (var m in Model.UserMedications)
                    {
                        if (Model.MedId == m.Id) { <option value="@m.Id" selected>@m.Name</option> }
                        else                     { <option value="@m.Id">@m.Name</option> }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wide">Status</label>
                <select name="Status" class="inp text-sm">
                    @foreach (var s in new[] { "All", "Taken", "Missed", "Skipped" })
                    {
                        if (Model.Status == s) { <option value="@s" selected>@s</option> }
                        else                   { <option value="@s">@s</option> }
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wide">From</label>
                <input type="date" name="DateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="inp text-sm" />
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wide">To</label>
                <input type="date" name="DateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="inp text-sm" />
            </div>
        </div>
        <div class="flex items-center gap-3">
            <div>
                <label class="block text-xs font-semibold text-slate-500 mb-1 uppercase tracking-wide">Sort</label>
                <select name="SortOrder" class="inp text-sm">
                    @if (Model.SortOrder == "asc") { <option value="desc">Newest first</option> <option value="asc" selected>Oldest first</option> }
                    else                           { <option value="desc" selected>Newest first</option> <option value="asc">Oldest first</option> }
                </select>
            </div>
            <div class="flex items-end gap-2 mt-auto pb-0.5">
                <button type="submit" class="bg-primary text-white text-sm font-bold px-5 py-2.5 rounded-xl hover:bg-primary-dark transition">Apply</button>
                <a href="/History" class="text-sm text-slate-400 hover:text-slate-600 px-3 py-2.5">Clear</a>
            </div>
        </div>
    </form>

    <!-- Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        @if (Model.Logs.Any())
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead class="bg-slate-50 text-xs text-slate-500 uppercase tracking-widest">
                        <tr>
                            <th class="px-6 py-3 text-left">Medication</th>
                            <th class="px-6 py-3 text-left">Scheduled</th>
                            <th class="px-6 py-3 text-left hidden sm:table-cell">Taken At</th>
                            <th class="px-6 py-3 text-left">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var l in Model.Logs)
                        {
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-6 py-3">
                                    <p class="font-bold text-ink">@l.Medication.Name</p>
                                    <p class="text-xs text-slate-500">@l.Medication.Dosage</p>
                                </td>
                                <td class="px-6 py-3 text-slate-600">@l.ScheduledFor.ToString("dd MMM, HH:mm")</td>
                                <td class="px-6 py-3 text-slate-500 hidden sm:table-cell">@(l.TakenAt?.ToString("dd MMM, HH:mm") ?? "—")</td>
                                <td class="px-6 py-3">
                                    @if (l.Status == "Taken")
                                    {
                                        <span class="inline-block bg-green-100 text-green-700 text-xs font-bold px-2 py-1 rounded-full">Taken</span>
                                    }
                                    else if (l.Status == "Skipped")
                                    {
                                        <span class="inline-block bg-slate-100 text-slate-600 text-xs font-bold px-2 py-1 rounded-full">Skipped</span>
                                    }
                                    else if (l.ScheduledFor < DateTime.Now.AddHours(-1))
                                    {
                                        <span class="inline-block bg-red-100 text-red-700 text-xs font-bold px-2 py-1 rounded-full">Missed</span>
                                    }
                                    else
                                    {
                                        <span class="inline-block bg-amber-100 text-amber-700 text-xs font-bold px-2 py-1 rounded-full">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="px-6 py-16 text-center text-slate-500">
                <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center mx-auto mb-4">
                    <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                    </svg>
                </div>
                <p class="font-semibold text-ink mb-1">No records found</p>
                <p class="text-sm">Try adjusting or <a href="/History" class="text-primary hover:underline">clearing</a> the filters.</p>
            </div>
        }
    </div>
</section>

@if (Model.ChartLabels != "[]")
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <script>
        const ctx = document.getElementById('adherenceChart');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.ChartLabels),
                datasets: [{
                    data: @Html.Raw(Model.ChartData),
                    borderColor: '#0d9488',
                    backgroundColor: 'transparent',
                    borderWidth: 2,
                    pointBackgroundColor: '#0d9488',
                    pointRadius: 3,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        min: 0, max: 100,
                        ticks: {
                            callback: v => v + '%',
                            font: { size: 11 },
                            color: '#94a3b8'
                        },
                        grid: { color: '#f1f5f9' }
                    },
                    x: {
                        ticks: {
                            maxRotation: 45,
                            font: { size: 10 },
                            color: '#94a3b8'
                        },
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
}
}
